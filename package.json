{
  "name": "vn-editor",
  "productName": "ノベルゲームエディタ",
  "version": "1.0.0",
  "description": "テキスト・選択肢分岐・立ち絵/背景・BGM/SE/ボイス・変数管理に対応したノベルゲーム作成エディタ。作成したゲームはセーブ機能付きの単体HTML/デスクトップアプリとして出力できます。",
  "main": "main/main.js",
  "author": "稜真",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "release": "electron-builder --win --publish always",
    "test:engine": "node test/engine.test.js"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "jsdom": "^30.0.1"
  },
  "dependencies": {
    "archiver": "^7.0.1"
  },
  "build": {
    "appId": "com.example.vneditor",
    "productName": "NovelGameEditor",
    "files": [
      "main/**/*",
      "renderer/**/*",
      "player-template/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": ["nsis", "portable"],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png"
    },
    "publish": {
      "provider": "github"
    }
  }
}
